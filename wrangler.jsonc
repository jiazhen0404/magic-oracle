{
  "name": "magic-oracle",
  "compatibility_date": "2026-08-28",
  "main": "src/index.js",
  "observability": { "enabled": true },

  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // ═══════════════════════════════════════════════════════════
  // 一般變數（Text）一定要寫在這裡。
  //
  // Cloudflare 每次建置都會用這個檔案重建變數清單，
  // 沒寫在這裡的會被清空——在後台手動設沒有用，推一次程式碼就沒了。
  //
  // Secret 不受影響，不要寫進來（這個檔案在 GitHub 上是公開的）：
  //   ADMIN_KEY / TEACHER_KEYS / ANTHROPIC_API_KEY
  //   RESEND_API_KEY / 綠界三把
  // ═══════════════════════════════════════════════════════════
  "vars": {
    // ── 延伸籤（99 元）。不要動 ──
    "ECPAY_MODE": "production",
    "CF_ACCOUNT_ID": "52b866ad397c38a72b9ef7c4a24622b1",

    // ── 真人占卜（399 元）──
    // production = 正式收款，會真的扣款
    // 要改回測試，把下一行整行刪掉，或值改成 "stage"
    "ORACLE_ECPAY_MODE": "production",

    // ── 寄信 ──
    // MAIL_FROM 必須用 Resend 驗證過的網域，不然會被拒絕（403）
    "MAIL_FROM": "未完籤所 <hello@unfinished.tw>",
    "ADMIN_EMAIL": "jiazhen0404@gmail.com",
    // ── 文章後台發布用（不是密鑰，token 要用 wrangler secret put）──
    "GITHUB_REPO": "jiazhen0404/magic-oracle",

    "SITE_URL": "https://unfinished.tw",
    "WORKER_URL": "https://unfinished.tw",

    // ── 老師信箱。變數名稱是 MAIL_ 加上代號大寫 ──
    // 代號要跟 TEACHER_KEYS 裡的一致（lightwalker / iris / james）
    // 拿到信箱後把 xxx 換掉，測試老師不用設
    "MAIL_LIGHTWALKER": "terrific0722@gmail.com",
    "MAIL_IRIS": "b0960691947@gmail.com",
    "MAIL_JAMES": "mysticat7779@gmail.com"
  },

  // ── 文章後台資料庫（D1）──
  // 建立方式：npx wrangler d1 create unfinished-articles
  // 指令會印出 database_id，貼到下面那行
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unfinished-articles",
      "database_id": "9feae632-aa28-41d5-a35a-d53bcf1c2a86"
    }
  ],

  // ── 讓 /api/health 知道「線上跑的是哪一版」──
  // Cloudflare 自動填入版本 id 與部署時間，不需要人工維護版號。
  // scripts/check-release.mjs 用它抓「建置完成但沒推上線」。
  "version_metadata": {
    "binding": "CF_VERSION"
  },

  "kv_namespaces": [
    {
      "binding": "ORDERS",
      "id": "c0cf3e32839b4f97b884fa838a4396ea"
    }
  ],

  // ── 牌陣照片。寫在這裡才不會被建置洗掉 ──
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "unfinished-media"
    }
  ]
}
